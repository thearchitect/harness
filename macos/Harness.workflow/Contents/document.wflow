				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string># The Finder Quick Action "Harness" (harness macos/): harness-open from the
# Nix profile harness is installed in. This file never changes with the
# bundle; the behavior lives in harness-open, which the profile updates.
for dir in "$HOME/.nix-profile/bin" "${XDG_STATE_HOME:-$HOME/.local/state}/nix/profile/bin" "/etc/profiles/per-user/$(id -un)/bin" /run/current-system/sw/bin /nix/var/nix/profiles/default/bin; do
  if [ -x "$dir/harness-open" ]; then
    exec "$dir/harness-open" "$@"
  else
    : # not in this profile
  fi
done
echo "harness-open is in no Nix profile: reinstall harness" &gt;&amp;2
exit 1</string>
					<key>CheckedForUserDefaultShell</key>
