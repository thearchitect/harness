{
  "name": "harness",
  "version": "0.2.0",
  "private": true,
  "description": "harness: a multi-session coding agent platform on pi — nodes, hub, protocol, TUI and app, background tasks, subagents; distributed as a Nix bundle",
  "type": "module",
  "author": "The Architect",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thearchitect/harness.git"
  },
  "homepage": "https://github.com/thearchitect/harness#readme",
  "engines": {
    "node": ">=22.19.0"
  },
  "imports": {
    "#protocol/*": "./packages/protocol/src/*",
    "#client/*": "./packages/client/src/*",
    "#node/*": "./packages/node/src/*",
    "#agent/*": "./packages/agent/src/*",
    "#extension/*": "./packages/extension/src/*",
    "#tui/*": "./packages/tui/src/*",
    "#cli/*": "./packages/cli/src/*",
    "#testkit/*": "./packages/testkit/src/*"
  }
}
